<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The cases are deliberately unidiomatic; keep the build quiet about them. -->
    <NoWarn>$(NoWarn);CS4014;CS1998;CS0219;CS0649;CS8321;CA1827;CA1829;CA1860</NoWarn>
  </PropertyGroup>
</Project>
