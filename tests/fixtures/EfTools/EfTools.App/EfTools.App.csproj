<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The N+1 cases are deliberately unidiomatic; keep the build quiet about them. -->
    <!-- NU1903: the SQLite native library of the test-only provider; it only ever opens a file in the temp folder. -->
    <NoWarn>$(NoWarn);CS8321;CS0219;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test-only (MIT). SQLite in a temp folder (EFTOOLS_DB); no server database is ever used. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
