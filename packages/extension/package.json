    "taskDefinitions": [
      {
        "type": "refyntra-restore",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "description": "Absolute path of the .sln, .slnx or .csproj passed to dotnet restore as one argument."
          }
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "refyntra.openLocation",
          "when": "false"
        },
        {
          "command": "refyntra.runRestore",
          "when": "false"
        },
        {
          "command": "refyntra.related.open",
          "when": "false"
        },
        {
          "command": "refyntra.nativeRename",
          "when": "false"
        },
        {
          "command": "refyntra.stackTrace.openFrame",
          "when": "false"
        },
        {
          "command": "refyntra.stackTrace.related",
          "when": "false"
        },
        {
          "command": "refyntra.stackTrace.clear",
          "when": "refyntra.stackTraceLoaded"
        },
        {
          "command": "refyntra.related.pin",
          "when": "!refyntra.relatedPinned"
        },
        {
          "command": "refyntra.related.unpin",
          "when": "refyntra.relatedPinned"
        },
        {
          "command": "refyntra.taskContext.addFindItem",
          "when": "false"
        },
        {
          "command": "refyntra.taskContext.addFromRelated",
          "when": "false"
        },
        {
          "command": "refyntra.taskContext.open",
          "when": "focusedView == refyntra.taskContextView"
        },
        {
          "command": "refyntra.taskContext.showRelated",
          "when": "focusedView == refyntra.taskContextView"
        },
        {
          "command": "refyntra.taskContext.moveUp",
          "when": "focusedView == refyntra.taskContextView"
        },
        {
          "command": "refyntra.taskContext.moveDown",
          "when": "focusedView == refyntra.taskContextView"
        },
        {
          "command": "refyntra.taskContext.remove",
          "when": "focusedView == refyntra.taskContextView"
        },
        {
          "command": "refyntra.taskContext.editNote",
          "when": "focusedView == refyntra.taskContextView"
        },
        {
          "command": "refyntra.taskContext.choose",
          "when": "focusedView == refyntra.taskContextView"
        },
        {
          "command": "refyntra.taskContext.rename",
          "when": "refyntra.taskContextActive"
        },
        {
          "command": "refyntra.taskContext.delete",
          "when": "refyntra.taskContextActive"
        },
        {
          "command": "refyntra.taskContext.clear",
          "when": "refyntra.taskContextActive"
        },
        {
          "command": "refyntra.taskContext.copyMarkdown",
          "when": "refyntra.taskContextActive"
        },
        {
          "command": "refyntra.taskContext.export",
          "when": "refyntra.taskContextActive"
        },
        {
          "command": "refyntra.taskContext.refresh",
          "when": "refyntra.taskContextActive"
        }
      ],
      "view/title": [
        {
          "command": "refyntra.related.pin",
          "when": "view == refyntra.relatedView && !refyntra.relatedPinned",
          "group": "navigation@1"
        },
        {
          "command": "refyntra.related.unpin",
          "when": "view == refyntra.relatedView && refyntra.relatedPinned",
          "group": "navigation@1"
        },
        {
          "command": "refyntra.related.refresh",
          "when": "view == refyntra.relatedView",
          "group": "navigation@2"
        },
        {
          "command": "refyntra.openStackTrace",
          "when": "view == refyntra.stackTraceView",
          "group": "navigation@1"
        },
        {
          "command": "refyntra.stackTrace.clear",
          "when": "view == refyntra.stackTraceView && refyntra.stackTraceLoaded",
          "group": "navigation@2"
        },
        {
          "command": "refyntra.taskContext.addSymbol",
          "when": "view == refyntra.taskContextView",
          "group": "navigation@1"
        },
        {
          "command": "refyntra.taskContext.switch",
          "when": "view == refyntra.taskContextView",
          "group": "navigation@2"
        },
        {
          "command": "refyntra.taskContext.refresh",
          "when": "view == refyntra.taskContextView && refyntra.taskContextActive",
          "group": "navigation@3"
        },
        {
          "command": "refyntra.taskContext.new",
          "when": "view == refyntra.taskContextView",
          "group": "1_context@1"
        },
        {
          "command": "refyntra.taskContext.rename",
          "when": "view == refyntra.taskContextView && refyntra.taskContextActive",
          "group": "1_context@2"
        },
        {
          "command": "refyntra.taskContext.delete",
          "when": "view == refyntra.taskContextView && refyntra.taskContextActive",
          "group": "1_context@3"
        },
        {
          "command": "refyntra.taskContext.addFile",
          "when": "view == refyntra.taskContextView",
          "group": "2_add@1"
        },
        {
          "command": "refyntra.taskContext.copyMarkdown",
          "when": "view == refyntra.taskContextView && refyntra.taskContextActive",
          "group": "3_share@1"
        },
        {
          "command": "refyntra.taskContext.export",
          "when": "view == refyntra.taskContextView && refyntra.taskContextActive",
          "group": "3_share@2"
        },
        {
          "command": "refyntra.taskContext.import",
          "when": "view == refyntra.taskContextView",
          "group": "3_share@3"
        },
        {
          "command": "refyntra.taskContext.clear",
          "when": "view == refyntra.taskContextView && refyntra.taskContextActive",
          "group": "4_clear@1"
        },
        {
          "command": "refyntra.taskContext.addFromRelated",
          "when": "view == refyntra.relatedView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "refyntra.stackTrace.related",
          "when": "view == refyntra.stackTraceView && viewItem == refyntra.stackFrame",
          "group": "inline"
        },
        {
          "command": "refyntra.taskContext.choose",
          "when": "view == refyntra.taskContextView && viewItem == refyntra.taskItem.ambiguous",
          "group": "inline@0"
        },
        {
          "command": "refyntra.taskContext.showRelated",
          "when": "view == refyntra.taskContextView && viewItem =~ /^refyntra\\.taskItem\\./",
          "group": "inline@1"
        },
        {
          "command": "refyntra.taskContext.open",
          "when": "view == refyntra.taskContextView && viewItem =~ /^refyntra\\.taskItem\\./",
          "group": "1_open@1"
        },
        {
          "command": "refyntra.taskContext.showRelated",
          "when": "view == refyntra.taskContextView && viewItem =~ /^refyntra\\.taskItem\\./",
          "group": "1_open@2"
        },
        {
          "command": "refyntra.taskContext.choose",
          "when": "view == refyntra.taskContextView && viewItem == refyntra.taskItem.ambiguous",
          "group": "1_open@3"
        },
        {
          "command": "refyntra.taskContext.editNote",
          "when": "view == refyntra.taskContextView && viewItem =~ /^refyntra\\.taskItem\\./",
          "group": "2_edit@1"
        },
        {
          "command": "refyntra.taskContext.moveUp",
          "when": "view == refyntra.taskContextView && viewItem =~ /^refyntra\\.taskItem\\./",
          "group": "3_order@1"
        },
        {
          "command": "refyntra.taskContext.moveDown",
          "when": "view == refyntra.taskContextView && viewItem =~ /^refyntra\\.taskItem\\./",
          "group": "3_order@2"
        },
        {
          "command": "refyntra.taskContext.remove",
          "when": "view == refyntra.taskContextView && viewItem =~ /^refyntra\\.taskItem\\./",
          "group": "4_remove@1"
        },
        {
          "command": "refyntra.taskContext.addFromRelated",
          "when": "view == refyntra.relatedView && viewItem == refyntra.relatedRelation",
          "group": "inline"
        }
      ],
      "terminal/context": [
        {
          "command": "refyntra.openStackTrace",
          "when": "terminalTextSelected",
          "group": "9_refyntra"
        }
      ],
      "explorer/context": [
        {
          "command": "refyntra.cleanup",
          "when": "explorerResourceIsFolder || resourceExtname == .cs || resourceExtname == .csproj",
          "group": "7_modification@90"
        },
        {
          "command": "refyntra.taskContext.addFile",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "7_modification@91"
        }
      ],
      "editor/context": [
        {
          "submenu": "refyntra.editorContext",
          "when": "editorLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact|python|rust)$/ && resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "refyntra.editorContext": [
        {
          "command": "refyntra.related",
          "group": "1_navigate@1"
        },
        {
          "command": "refyntra.actions",
          "group": "1_navigate@2"
        },
        {
          "command": "refyntra.find",
          "group": "1_navigate@3"
        },
        {
          "command": "refyntra.rename",
          "group": "2_refactor@1"
        },
        {
          "command": "refyntra.taskContext.addSymbol",
          "group": "3_context@1"
        },
        {
          "command": "refyntra.taskContext.addFile",
          "group": "3_context@2"
        }
      ]
    },
    "submenus": [
      {
        "id": "refyntra.editorContext",
        "label": "Refyntra"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "refyntra",
          "title": "Refyntra",
          "icon": "media/refyntra.svg"
        }
      ]
    },
    "views": {
      "refyntra": [
        {
          "id": "refyntra.relatedView",
          "name": "Refyntra Related",
          "contextualTitle": "Refyntra"
        },
        {
          "id": "refyntra.stackTraceView",
          "name": "Refyntra Stack Trace",
          "contextualTitle": "Refyntra"
        },
        {
          "id": "refyntra.taskContextView",
          "name": "Refyntra Task Context",
          "contextualTitle": "Refyntra"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "refyntra.stackTraceView",
        "when": "!refyntra.stackTraceLoaded",
        "contents": "Paste a stack trace to open its frames in your code: .NET (including async, lambdas, Mono and Unity), JavaScript/TypeScript, Python and Rust. Files are matched by path; .NET frames without a usable file are looked up by symbol. Nothing is run.\n[Open Stack Trace](command:refyntra.openStackTrace)"
      },
      {
        "view": "refyntra.relatedView",
        "when": "refyntra.welcome == ready || !refyntra.welcome",
        "contents": "Refyntra helps you write, analyse and navigate code: find anything, see how code is connected (callers, implementations, tests, request handlers, endpoints, DI registrations), get focused diagnostics and rename safely with a preview.\nTo start, open a C# file and put the cursor on a class, interface or method, then choose Related. TypeScript and JavaScript files work too.\n[Related](command:refyntra.related)\n[Find](command:refyntra.find)\n[Actions](command:refyntra.actions)\n[Rename](command:refyntra.rename)\n[Health](command:refyntra.showHealth)\n[Keyboard shortcuts](command:refyntra.keyboardShortcuts)\n[Get started](command:refyntra.getStarted)"
      },
      {
        "view": "refyntra.relatedView",
        "when": "refyntra.welcome == untrusted",
        "contents": "This workspace is in Restricted Mode. Refyntra does not start its C# backend (no MSBuild, restore or build) until you trust the workspace, so Find, Related, Actions and Rename are unavailable for C#.\n[Manage Workspace Trust](command:workbench.trust.manage)\n[Health](command:refyntra.showHealth)\n[Get started](command:refyntra.getStarted)"
      },
      {
        "view": "refyntra.relatedView",
        "when": "refyntra.welcome == noSolution",
        "contents": "No C# solution or project was found in this workspace. Open a folder with a .sln, .slnx or .csproj file, or choose one. TypeScript and JavaScript files still work: put the cursor on a symbol and choose Related.\n[Select Solution](command:refyntra.selectSolution)\n[Related](command:refyntra.related)\n[Find](command:refyntra.find)\n[Get started](command:refyntra.getStarted)"
      },
      {
        "view": "refyntra.relatedView",
        "when": "refyntra.welcome == hostFailed",
        "contents": "The Refyntra C# backend could not start, so C# features are unavailable. The Health page shows the reason and how to fix it (for example a missing .NET SDK).\n[Health](command:refyntra.showHealth)\n[Restart Backend](command:refyntra.restartBackend)\n[Export Debug Bundle](command:refyntra.exportDebugBundle)\n[Get started](command:refyntra.getStarted)"
      },
      {
        "view": "refyntra.taskContextView",
        "when": "!refyntra.taskContextActive",
        "contents": "Collect the symbols, files, endpoints and relations you work on for a task. Items are stored locally for this workspace and found again after code changes (resolved, moved, ambiguous or missing).\n[New Task Context](command:refyntra.taskContext.new)\n[Add Symbol at Cursor](command:refyntra.taskContext.addSymbol)\n[Import from File](command:refyntra.taskContext.import)"
      }
    ],
    "walkthroughs": [
      {
        "id": "refyntra.getStarted",
        "title": "Get started with Refyntra",
        "description": "Find code, see how it is connected and rename safely: seven short steps.",
        "steps": [
          {
            "id": "solution",
            "title": "Open a C# solution and check Health",
            "description": "Open a folder with a .sln, .slnx or .csproj. The status bar shows Refyntra: C# Ready when the solution is loaded. The Health page says in one line whether C# works and offers the fix, for example Restore packages.\n[Show Health](command:refyntra.showHealth)",
            "media": {
              "markdown": "walkthrough/1-solution.md"
            }
          },
          {
            "id": "related",
            "title": "See how code is connected (Related)",
            "description": "Put the cursor on a class, interface or method and open Related.\n[Show Related](command:refyntra.related)",
            "media": {
              "markdown": "walkthrough/2-related.md"
            }
          },
          {
            "id": "find",
            "title": "Find with filters",
            "description": "Search types, members, files and endpoints. Narrow with type:, member:, project:, route:, method:.\n[Open Find](command:refyntra.find)",
            "media": {
              "markdown": "walkthrough/3-find.md"
            }
          },
          {
            "id": "actions",
            "title": "Actions and safe Rename",
            "description": "See what you can do at the cursor; rename with a preview, then Apply.\n[Open Actions](command:refyntra.actions)\n[Rename](command:refyntra.rename)",
            "media": {
              "markdown": "walkthrough/4-actions-rename.md"
            }
          },
          {
            "id": "stacktrace",
            "title": "Open a stack trace",
            "description": "Paste a .NET, JavaScript/TypeScript, Python or Rust stack trace; click a frame to open the file at the line, or the method found by symbol.\n[Open Stack Trace](command:refyntra.openStackTrace)",
            "media": {
              "markdown": "walkthrough/6-stack-trace.md"
            }
          },
          {
            "id": "taskcontext",
            "title": "Keep a task context",
            "description": "Collect the symbols, files and relations of your current task. Items are stored locally and found again after edits.\n[Add Symbol at Cursor](command:refyntra.taskContext.addSymbol)",
            "media": {
              "markdown": "walkthrough/7-task-context.md"
            }
          },
          {
            "id": "keys",
            "title": "Keyboard presets",
            "description": "Use Visual Studio or ReSharper style shortcuts for Find, Related, Actions and Rename.\n[Choose a preset](command:refyntra.keyboardShortcuts)",
            "media": {
              "markdown": "walkthrough/5-keyboard.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Refyntra",
      "properties": {
        "refyntra.hostPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to `Refyntra.Host.dll` (started with `dotnet`) or to a host executable. Empty = the host bundled with the extension. Machine scope only: a workspace cannot change which executable runs."
        },
        "refyntra.rename.apply": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer **Apply rename** after the preview. After you confirm, the plan is revalidated, every target file is checked against the previewed text, the edit is applied to the editor buffers (not saved) and the result is reconciled per file. Undo works through the editor. Turn off for preview-only renames."
        },
        "refyntra.keybindings.preset": {
          "type": "string",
          "enum": [
            "none",
            "visualStudio",
            "resharper"
          ],
          "enumDescriptions": [
            "No Refyntra keybindings. F12, Shift+F12 and your shortcuts stay untouched.",
            "Visual Studio-like (default): Ctrl+, Find, Ctrl+. Actions, Ctrl+R Ctrl+R Rename, Ctrl+Shift+Alt+F12 Related.",
            "ReSharper-like: Ctrl+T Find, Alt+Enter Actions, Ctrl+Shift+R Rename, Ctrl+Shift+G Related."
          ],
          "default": "visualStudio",
          "markdownDescription": "Keybinding preset for Find / Related / Actions / Rename. Presets override some VS Code defaults (e.g. Ctrl+T, Ctrl+.) while active; choose `none` to turn Refyntra shortcuts off."
        },
        "refyntra.http.basePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Frontend ↔ backend links (heuristic): path prefixes that client calls add but the ASP.NET routes do not have (for example `/backend` when a dev proxy removes it). By default only exact route matches are linked; a prefix is removed from the client URL only when the exact match finds nothing."
        },
        "refyntra.http.origins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Frontend ↔ backend links (heuristic): absolute origins that are this backend, for example `https://localhost:5001`. Client calls to any other absolute URL are never linked."
        },
        "refyntra.related.followCursor": {
          "type": "boolean",
          "default": true,
          "description": "Update the Related view when the cursor moves (unless the view is pinned)."
        },
        "refyntra.trace.level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Log level of the Refyntra output channel. Logs never contain source text."
        },
        "refyntra.cleanup.profile": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "removeUnnecessaryUsings",
              "sortUsings",
              "fileScopedNamespace",
              "whitespace"
            ]
          },
          "uniqueItems": true,
          "default": [
            "removeUnnecessaryUsings",
            "sortUsings",
            "whitespace"
          ],
          "markdownDescription": "Fixes pre-selected by **Refyntra: Code Cleanup** (each run can toggle them). Every fix is applied only where Roslyn proves the code means the same; anything else is skipped with the reason in the preview. `fileScopedNamespace` and `whitespace` act only when `.editorconfig` asks for them (`csharp_style_namespace_declarations = file_scoped`, `trim_trailing_whitespace`, `insert_final_newline`). Files are never saved automatically."
        },
        "refyntra.rules.OR1001": {
          "type": "string",
          "enum": [
            "off",
            "information",
            "warning"
          ],
          "enumDescriptions": [
            "Do not publish OR1001.",
            "Publish OR1001 as information.",
            "Publish OR1001 as a warning (default)."
          ],
          "default": "warning",
          "markdownDescription": "Experimental rule OR1001 \"scoped service captured by a singleton\": reported only for a proven constructor path inside one composition root ([docs](https://github.com/refyntra/refyntra/blob/main/docs/rules/OR1001.md)). When it cannot prove a path it stays silent; the reason is shown by the code action *Refyntra: why OR1001 did not check this registration*, never in Problems."
        }
      }
    },
    "keybindings": [
      {
        "command": "refyntra.find",
        "key": "ctrl+,",
        "mac": "cmd+,",
        "when": "config.refyntra.keybindings.preset == 'visualStudio'"
      },
      {
        "command": "refyntra.actions",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "config.refyntra.keybindings.preset == 'visualStudio' && editorTextFocus && editorLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact|python|rust)$/"
      },
      {
        "command": "refyntra.rename",
        "key": "ctrl+r ctrl+r",
        "mac": "cmd+r cmd+r",
        "when": "config.refyntra.keybindings.preset == 'visualStudio' && editorTextFocus && editorLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact|python|rust)$/"
      },
      {
        "command": "refyntra.related",
        "key": "ctrl+shift+alt+f12",
        "mac": "cmd+shift+alt+f12",
        "when": "config.refyntra.keybindings.preset == 'visualStudio' && editorTextFocus && editorLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact|python|rust)$/"
      },
      {
        "command": "refyntra.find",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "config.refyntra.keybindings.preset == 'resharper'"
      },
      {
        "command": "refyntra.actions",
        "key": "alt+enter",
        "mac": "alt+enter",
        "when": "config.refyntra.keybindings.preset == 'resharper' && editorTextFocus && editorLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact|python|rust)$/"
      },
      {
        "command": "refyntra.rename",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "config.refyntra.keybindings.preset == 'resharper' && editorTextFocus && editorLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact|python|rust)$/"
      },
      {
        "command": "refyntra.related",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "config.refyntra.keybindings.preset == 'resharper' && editorTextFocus && editorLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact|python|rust)$/"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:integration": "node scripts/build.mjs && node test/runTest.mjs",
    "test:e2e": "node scripts/build.mjs && node test/runTest.mjs --e2e",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@refyntra/adapter-vscode-providers": "workspace:*",
    "@refyntra/adapter-lsp": "workspace:*",
    "@refyntra/adapter-web-styles": "workspace:*",
    "@refyntra/web-frameworks": "workspace:*",
    "@refyntra/application": "workspace:*",
    "@refyntra/contracts": "workspace:*",
    "@refyntra/domain": "workspace:*",
    "@refyntra/infrastructure": "workspace:*",
    "@types/node": "22.18.6",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.10",
    "pyright": "1.1.414",
    "typescript": "5.9.3"
  }
}
