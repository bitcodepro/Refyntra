      },
      {
        "command": "refyntra.taskContext.addFile",
        "title": "Add File to Task Context",
        "category": "Refyntra",
        "icon": "$(new-file)"
      },
      {
        "command": "refyntra.taskContext.addFindItem",
        "title": "Add Find Result to Task Context",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.taskContext.addFromRelated",
        "title": "Add to Task Context",
        "category": "Refyntra",
        "icon": "$(add)"
      },
      {
        "command": "refyntra.taskContext.open",
        "title": "Open Task Context Item",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.taskContext.showRelated",
        "title": "Show Related for Task Context Item",
        "category": "Refyntra",
        "icon": "$(references)"
      },
      {
