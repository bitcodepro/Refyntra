        "icon": "$(add)"
      },
      {
        "command": "refyntra.taskContext.switch",
        "title": "Switch Task Context",
        "category": "Refyntra",
        "icon": "$(list-selection)"
      },
      {
        "command": "refyntra.taskContext.rename",
        "title": "Rename Task Context",
        "category": "Refyntra",
        "icon": "$(edit)"
      },
      {
        "command": "refyntra.taskContext.delete",
        "title": "Delete Task Context",
        "category": "Refyntra",
        "icon": "$(trash)"
      },
      {
        "command": "refyntra.taskContext.clear",
        "title": "Clear Task Context",
        "category": "Refyntra",
        "icon": "$(clear-all)"
      },
      {
        "command": "refyntra.taskContext.addSymbol",
