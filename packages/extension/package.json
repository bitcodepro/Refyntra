{
  "name": "refyntra",
  "displayName": "Refyntra",
  "description": "A free code companion for writing, analysing and navigating code: find anything, see how code is connected (callers, implementations, tests, request handlers, endpoints, DI registrations), get focused diagnostics and rename safely with a preview. C# is analysed with Roslyn; TypeScript and JavaScript use VS Code's built-in language features; Python and Rust use the Pyright and rust-analyzer language servers bundled with Refyntra, so no other extension is needed.",
  "version": "0.1.0",
  "preview": true,
  "publisher": "refyntra",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/refyntra/refyntra.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "code navigation",
    "code analysis",
    "refactoring",
    "rename",
    "csharp",
    "typescript",
    "javascript",
    "python",
    "rust",
    "dependency injection",
    "aspnetcore",
    "mediatr"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.{sln,slnx,csproj}"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode Refyntra only lists solution and project files and shows its UI and health. It does not start the C# host, does not run MSBuild evaluation, restore, build, source generators or analyzers, and does not read the refyntra.hostPath setting from the workspace, and does not start the bundled Python (Pyright) or Rust (rust-analyzer) language servers. Find, Related, Actions and Rename explain that the workspace must be trusted.",
      "restrictedConfigurations": [
        "refyntra.hostPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Refyntra needs a local file system and a local .NET host."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "refyntra.find",
        "title": "Find",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.related",
        "title": "Related",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.actions",
        "title": "Actions",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.rename",
        "title": "Rename",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.moveTypeToFile",
        "title": "Move Type to File",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.generateHandler",
        "title": "Generate Handler (MediatR)",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.safeDelete",
        "title": "Safe Delete",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.extractMethod",
        "title": "Extract Method",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.changeSignature",
        "title": "Change Signature",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.cleanup",
        "title": "Code Cleanup",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.showHealth",
        "title": "Show Health",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.showHealthText",
        "title": "Show Health (text)",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.restartBackend",
        "title": "Restart Backend",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.exportDebugBundle",
        "title": "Export Debug Bundle",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.selectSolution",
        "title": "Select Solution",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.showMenu",
        "title": "Show Menu",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.getStarted",
        "title": "Get Started",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.keyboardShortcuts",
        "title": "Keyboard Shortcuts Preset",
        "category": "Refyntra"
      },
      {
        "command": "refyntra.findHandler",
        "title": "Find Handler",
        "category": "Refyntra"
